{
  "manifest_version": 3,
  "name": "SF Dev Toolkit — Permissions, CLI Auth & Explorer",
  "version": "2.0.0",
  "description": "Audit and edit Salesforce permissions, generate sf CLI access-token login commands, run SOQL/Apex/REST, view logs and limits — from any Salesforce tab.",

  "minimum_chrome_version": "116",

  "permissions": [
    "cookies",
    "tabs",
    "storage",
    "notifications",
    "clipboardWrite"
  ],

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "host_permissions": [
    "https://*.salesforce.com/*",
    "https://*.force.com/*",
    "https://*.salesforce-setup.com/*",
    "https://*.cloudforce.com/*",
    "https://*.visualforce.com/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_title": "SF Dev Toolkit (Alt+Shift+S)"
  },

  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      },
      "description": "Open SF Dev Toolkit"
    }
  }
}
